#!/usr/bin/env bash
# orchestrator — LEGACY.
# Agent orchestrator/full-lifecycle TIDAK lagi dibundel (sejak v1.20.12 paket
# ini tidak membawa agent/command/skill bawaan — lingkungan bersih).
# Skrip ini kini alias tipis: teruskan semua argumen ke opencode-termux.
set -euo pipefail
if ! command -v opencode-termux >/dev/null 2>&1; then
  echo "[orchestrator] opencode-termux tidak ada di PATH — install dulu:" >&2
  echo "  npm install -g @nemoobc/opencode-termux" >&2
  exit 1
fi
exec opencode-termux "$@"
